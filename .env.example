# Ruta al repo de Deloitte clonado (https://github.com/dttdfr/DTT-UAB-The-Hack)
DATASET_DIR=../DTT-UAB-The-Hack

# URL de la API simulada de Deloitte (uvicorn mock_soc_api:app --port 8000)
SOC_API_URL=http://localhost:8000

# Orden de proveedores LLM (el primero que funcione gana)
LLM_PROVIDERS=claude_code,gemini

# Claude Code (usa la suscripción del login de `claude`). Recomendado: sonnet para ahorrar cuota
CLAUDE_MODEL=sonnet

# Gemini (fallback) - API key gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash ya no está disponible para claves nuevas (404 "no longer available to new users", 07/11)
GEMINI_MODEL=gemini-3.8-flash

# Chat IA del ticket en el dashboard (docs/12_chatbot.md). Usa GEMINI_API_KEY. Opcionales:
# CHAT_GEMINI_MODEL=gemini-3.8-flash          (si no, GEMINI_MODEL)
# CHAT_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite

LLM_TIMEOUT=180
